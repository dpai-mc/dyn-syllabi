{
  "metadata": {
    "code": "CSC210L",
    "title": "Computer Organization and Architecture Lab",
    "credits": "1",
    "creditBreakdown": "1 lab",
    "format": "Hybrid",
    "term": "Fall 2026",
    "prerequisite": "CSC221 - Programming and Algorithms I",
    "corequisite": "CSC210 - Computer Organization and Architecture",
    "transferable": "UC/CSU Transferable"
  },
  "description": {
    "catalog": "Laboratory course accompanying CSC210. Hands-on experience with assembly language programming and computer architecture simulation.",
    "expanded": "This lab course provides practical, hands-on experience with the concepts taught in CSC210. Students will write and debug assembly language programs, simulate computer architecture concepts, and gain practical skills in low-level programming and system analysis."
  },
  "purpose": {
    "why": "This lab complements CSC210 by providing hands-on practice with assembly language programming and architecture simulation. You'll develop practical skills that reinforce theoretical concepts and prepare you for real-world low-level programming tasks.",
    "beyond": "Beyond technical skills, you'll develop debugging expertise, systematic problem-solving approaches, and deeper understanding of how software interacts with hardware at the lowest levels."
  },
  "slos": [
    "Write and debug assembly language programs for various tasks",
    "Simulate computer architecture concepts using industry-standard tools",
    "Analyze program performance at the instruction level",
    "Apply low-level programming techniques to solve computational problems"
  ],
  "schedule": {
