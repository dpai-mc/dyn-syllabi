{
  "metadata": {
    "code": "CSC141",
    "title": "AI Literacy",
    "credits": "3",
    "creditBreakdown": "3 lecture",
    "format": "Online",
    "term": "Fall 2026",
    "prerequisite": "None"
  },
  "description": {
    "catalog": "Introduction to artificial intelligence concepts, tools, and applications. Students will learn to use AI tools effectively, understand AI limitations, and develop critical thinking skills for evaluating AI-generated content.",
    "expanded": "This course provides a comprehensive foundation in artificial intelligence literacy, covering fundamental concepts, practical tool usage, prompt engineering, ethical considerations, and the societal impact of AI. Students will develop the skills needed to navigate an AI-augmented world responsibly and effectively."
  },
  "purpose": {
    "why": "This course prepares you to work effectively with AI tools in academic, professional, and personal contexts. You'll develop critical evaluation skills, understand ethical implications, and gain practical experience with current AI technologies. These competencies are essential for success in any field in the AI era.",
    "beyond": "Beyond technical skills, you'll develop critical thinking about AI's role in society, understand bias and fairness issues, and learn to protect your data privacy while leveraging AI capabilities."
  },
  "slos": [
    "Define key artificial intelligence terminology and concepts",
    "Demonstrate proficiency in using AI tools for various tasks",
    "Design effective prompts for AI systems",
    "Evaluate AI-generated content for accuracy and quality",
    "Apply data protection principles when using AI tools",
    "Analyze ethical frameworks related to AI development and use"
  ],
