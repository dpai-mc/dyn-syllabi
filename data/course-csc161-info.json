            "assignments": [
              "Assignment 10: Architecture Review Exercise (25 pts)",
              "Quiz 13: Cloud Architecture (10 pts)",
              "Discussion 13: Multi-Cloud Strategies (5 pts)"
            ],
            "deliverableDueDate": "Week 13 Sunday 11:59 PM"
          },
