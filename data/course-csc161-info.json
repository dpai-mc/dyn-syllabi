            "dates": "10/19/2026 - 10/25/2026",
            "topics": [
              "Cloud risk assessment methodologies",
              "Cloud security posture management (CSPM)",
              "Vulnerability management in the cloud",
              "Cloud penetration testing"
            ],
            "assignments": [
              "Assignment 8: Risk Assessment Exercise (25 pts)",
              "Quiz 10: Risk Management (10 pts)",
              "Discussion 10: CSPM Tools (5 pts)"
            ],
            "deliverableDueDate": "Week 10 Sunday 11:59 PM"
          },
          {
            "weekNumber": 11,
            "dates": "10/26/2026 - 11/1/2026",
            "topics": [
              "Cloud incident response",
              "Cloud forensics",
              "Incident response planning for cloud environments",
              "Project 2: Cloud Security Risk Assessment"
            ],
            "assignments": [
              "Project 2: Cloud Security Risk Assessment Due (40 pts)",
              "Quiz 11: Incident Response (10 pts)",
              "Discussion 11: Cloud Forensics Challenges (5 pts)"
            ],
            "deliverableDueDate": "Week 11 Sunday 11:59 PM"
          },
          {
