              "Quiz 14: Container & Serverless Security (10 pts)",
              "Discussion 14: DevSecOps Implementation (5 pts)"
            ],
            "deliverableDueDate": "Week 14 Sunday 11:59 PM"
          },
          {
            "weekNumber": 15,
            "dates": "11/23/2026 - 11/29/2026",
            "topics": [
              "Cloud security automation",
              "Security orchestration in the cloud",
              "Zero trust architecture in cloud",
              "Project 3: Secure Cloud Infrastructure Design"
            ],
            "assignments": [
              "Project 3: Secure Cloud Infrastructure Design Due (40 pts)",
              "Discussion 15: Zero Trust in Cloud (5 pts)",
              "Note: Thanksgiving Break - No Class 11/25-11/29"
            ],
            "deliverableDueDate": "Week 15 Sunday 11:59 PM"
          }
        ]
      },
      {
        "title": "Phase 5: Certification Prep & Final Assessment (Weeks 16-17)",
        "description": "CCSSE certification preparation and course culmination",
        "weeks": [
          {
            "weekNumber": 16,
            "dates": "11/30/2026 - 12/6/2026",
            "topics": [
              "CCSSE certification overview",
              "Exam objectives review",
              "Practice scenarios and case studies",
              "Career pathways in cloud security"
            ],
            "assignments": [
              "Assignment 12: Certification Study Plan (20 pts)",
              "Quiz 16: CCSSE Review (10 pts)",
              "Discussion 16: Career Goals (5 pts)"
            ],
            "deliverableDueDate": "Week 16 Sunday 11:59 PM"
          },
          {
            "weekNumber": 17,
            "dates": "12/7/2026 - 12/11/2026",
            "topics": [
