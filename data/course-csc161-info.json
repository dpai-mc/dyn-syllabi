            "dates": "11/2/2026 - 11/8/2026",
            "topics": [
              "Cloud compliance frameworks",
              "GDPR, HIPAA, PCI-DSS in the cloud",
              "Cloud audit preparation",
              "Compliance automation"
            ],
            "assignments": [
              "Assignment 9: Compliance Framework Analysis (25 pts)",
              "Quiz 12: Cloud Compliance (10 pts)",
              "Discussion 12: Compliance Automation (5 pts)"
            ],
            "deliverableDueDate": "Week 12 Sunday 11:59 PM"
          }
        ]
      },
      {
        "title": "Phase 4: Secure Cloud Architecture & DevSecOps (Weeks 13-15)",
        "description": "Advanced topics in cloud architecture, container security, and DevSecOps integration",
        "weeks": [
          {
            "weekNumber": 13,
