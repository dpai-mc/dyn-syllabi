{
  "metadata": {
    "code": "CSC161",
    "title": "Cloud Infrastructure and Security",
    "credits": "3",
    "creditBreakdown": "3 lecture",
    "format": "Hybrid",
    "term": "Fall 2026",
    "prerequisite": "CSC152 or equivalent networking knowledge",
    "meetingSchedule": {
      "days": "Thursday",
      "time": "5:30 PM - 6:50 PM",
      "location": "Zoom",
      "modality": "Synchronous online (Hybrid course: 1/2 synchronous Zoom, 1/2 asynchronous online)"
    }
  },
  "description": {
    "catalog": "Comprehensive study of cloud computing security, covering cloud service providers, security implementation, data protection, and cloud infrastructure design.",
    "expanded": "This course provides in-depth coverage of cloud security principles, practices, and technologies. Students will learn to evaluate cloud service providers for security, implement cloud security controls, identify and mitigate cloud data risks, and build secure cloud infrastructures."
  },
  "purpose": {
    "why": "This course prepares you for cloud security roles by developing expertise in cloud architecture security, compliance, and risk management. You'll gain practical skills in securing cloud environments across major platforms.",
    "beyond": "Beyond technical implementation, you'll develop strategic thinking about cloud security governance, understand regulatory compliance requirements, and learn to design resilient cloud architectures."
  },
  "slos": [
    "Evaluate cloud service providers for security capabilities and compliance",
    "Implement cloud security controls and best practices",
    "Identify and mitigate cloud data risks and vulnerabilities",
    "Build secure cloud infrastructures following industry standards"
  ],
  "schedule": {
    "phases": [
      {
        "title": "Phase 1: Cloud Computing Fundamentals (Weeks 1-4)",
        "description": "Build foundation in cloud computing concepts, service models, and deployment strategies",
        "weeks": [
          {
            "weekNumber": 1,
            "dates": "8/17/2026 - 8/23/2026",
            "topics": [
              "Course overview and expectations",
              "Introduction to cloud computing",
              "Cloud service models (IaaS, PaaS, SaaS)",
              "Cloud deployment models (public, private, hybrid)"
            ],
            "assignments": [
              "Assignment 1: Cloud Platform Setup (20 pts)",
              "Quiz 1: Cloud Fundamentals (10 pts)",
              "Discussion 1: Cloud Adoption Trends (5 pts)"
            ],
            "deliverableDueDate": "Week 1 Sunday 11:59 PM"
          },
          {
            "weekNumber": 2,
            "dates": "8/24/2026 - 8/30/2026",
            "topics": [
              "Major cloud service providers overview",
              "AWS, Azure, and Google Cloud Platform comparison",
              "Cloud pricing models and cost optimization",
              "Shared responsibility model"
            ],
            "assignments": [
              "Assignment 2: CSP Comparison Analysis (25 pts)",
              "Quiz 2: Cloud Providers (10 pts)",
              "Discussion 2: Choosing a Cloud Provider (5 pts)"
            ],
            "deliverableDueDate": "Week 2 Sunday 11:59 PM"
          },
          {
            "weekNumber": 3,
            "dates": "8/31/2026 - 9/6/2026",
            "topics": [
              "Cloud security fundamentals",
              "Cloud security challenges and threats",
              "Identity and Access Management (IAM)",
              "Authentication and authorization in the cloud"
            ],
            "assignments": [
              "Assignment 3: IAM Configuration Lab (25 pts)",
              "Quiz 3: Cloud Security Basics (10 pts)",
              "Discussion 3: IAM Best Practices (5 pts)"
            ],
            "deliverableDueDate": "Week 3 Sunday 11:59 PM"
          },
          {
            "weekNumber": 4,
            "dates": "9/7/2026 - 9/13/2026",
            "topics": [
              "Evaluating CSP security capabilities",
              "Security certifications and compliance",
              "Cloud security assessment frameworks",
              "Project 1: CSP Security Evaluation"
            ],
            "assignments": [
              "Project 1: CSP Security Evaluation Due (40 pts)",
              "Quiz 4: Security Assessment (10 pts)",
              "Discussion 4: Compliance Requirements (5 pts)"
            ],
            "deliverableDueDate": "Week 4 Sunday 11:59 PM"
          }
        ]
      },
      {
        "title": "Phase 2: Cloud Security Implementation (Weeks 5-8)",
        "description": "Learn to implement security controls, network security, and encryption in cloud environments",
        "weeks": [
          {
            "weekNumber": 5,
            "dates": "9/14/2026 - 9/20/2026",
            "topics": [
              "Cloud network security",
              "Virtual private clouds (VPC)",
              "Security groups and network ACLs",
              "Cloud firewalls and DDoS protection"
            ],
            "assignments": [
              "Assignment 4: VPC Security Lab (25 pts)",
              "Quiz 5: Network Security (10 pts)",
              "Discussion 5: Network Segmentation (5 pts)"
            ],
            "deliverableDueDate": "Week 5 Sunday 11:59 PM"
          },
          {
            "weekNumber": 6,
            "dates": "9/21/2026 - 9/27/2026",
            "topics": [
              "Encryption in the cloud",
              "Data encryption at rest and in transit",
              "Key management services (KMS)",
              "Certificate management"
            ],
            "assignments": [
              "Assignment 5: Encryption Implementation Lab (25 pts)",
              "Quiz 6: Encryption & KMS (10 pts)",
              "Discussion 6: Key Management Challenges (5 pts)"
            ],
            "deliverableDueDate": "Week 6 Sunday 11:59 PM"
          },
          {
            "weekNumber": 7,
            "dates": "9/28/2026 - 10/4/2026",
            "topics": [
              "Cloud security monitoring and logging",
              "Cloud-native security tools",
              "Security information and event management (SIEM)",
              "Cloud audit and compliance tools"
            ],
            "assignments": [
              "Assignment 6: Cloud Monitoring Setup (25 pts)",
              "Quiz 7: Security Monitoring (10 pts)",
              "Discussion 7: Log Management Strategies (5 pts)"
            ],
            "deliverableDueDate": "Week 7 Sunday 11:59 PM"
          },
          {
            "weekNumber": 8,
            "dates": "10/5/2026 - 10/11/2026",
            "topics": [
              "Midterm review",
              "Integration of cloud security controls",
              "Case studies in cloud security implementation"
            ],
            "assignments": [
              "Midterm Exam (40 pts)",
              "Discussion 8: Midterm Reflections (5 pts)"
            ],
            "deliverableDueDate": "Week 8 Sunday 11:59 PM"
          }
        ]
      },
      {
        "title": "Phase 3: Cloud Data Security & Risk Management (Weeks 9-12)",
        "description": "Master data protection, risk assessment, and vulnerability management in cloud environments",
        "weeks": [
          {
            "weekNumber": 9,
            "dates": "10/12/2026 - 10/18/2026",
            "topics": [
              "Cloud data classification",
              "Data loss prevention (DLP)",
              "Data residency and sovereignty",
              "Cloud backup and disaster recovery"
            ],
            "assignments": [
              "Assignment 7: Data Classification Exercise (25 pts)",
              "Quiz 9: Data Protection (10 pts)",
              "Discussion 9: Data Sovereignty Issues (5 pts)"
