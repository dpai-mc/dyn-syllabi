            "weekNumber": 14,
            "dates": "11/16/2026 - 11/22/2026",
            "topics": [
              "Container and Kubernetes security",
              "Serverless security",
              "DevSecOps practices",
              "Infrastructure as Code (IaC) security"
            ],
            "assignments": [
