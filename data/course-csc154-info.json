{
  "metadata": {
    "code": "CSC154",
    "title": "Network Security",
    "credits": "3",
    "creditBreakdown": "3 lecture",
    "format": "Hybrid",
    "term": "Fall 2026",
    "prerequisite": "CSC152 or equivalent networking knowledge",
    "meetingSchedule": {
      "days": "Tuesday",
      "time": "5:30 PM - 6:50 PM",
      "location": "Zoom",
      "modality": "Synchronous online (Hybrid course: 1/2 synchronous Zoom, 1/2 asynchronous online)"
    }
  },
  "description": {
    "catalog": "Introduction to network security concepts, threat analysis, and security monitoring. Prepares students for CompTIA CySA+ certification.",
    "expanded": "This course provides comprehensive coverage of network security analysis, threat detection, vulnerability assessment, and incident response. Students will learn to apply security monitoring tools, analyze security data, and implement threat responses in real-world scenarios."
  },
  "purpose": {
    "why": "This course prepares you for a career in cybersecurity by developing practical skills in threat detection, vulnerability analysis, and incident response. You'll gain knowledge aligned with the CompTIA CySA+ certification.",
    "beyond": "Beyond technical skills, you'll develop analytical thinking for security assessments, understand risk management principles, and learn to communicate security findings effectively."
  },
  "slos": [
    "Apply reconnaissance techniques to identify potential security threats",
    "Implement appropriate responses to security threats and vulnerabilities",
    "Distinguish between different types of threat data and security events",
    "Summarize incident recovery procedures and best practices"
  ],
