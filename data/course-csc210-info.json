{
  "metadata": {
    "code": "CSC210",
    "title": "Computer Organization and Architecture",
    "credits": "3",
    "creditBreakdown": "3 lecture",
    "format": "Online",
    "term": "Fall 2026",
    "prerequisite": "CSC221 - Programming and Algorithms I",
    "transferable": "UC/CSU Transferable"
  },
  "description": {
    "catalog": "Study of computer organization and architecture, including digital logic, assembly language programming, and the relationship between high-level languages and machine language.",
    "expanded": "This course provides a comprehensive understanding of how computers work at the hardware and low-level software interface. Students will learn digital logic design, computer architecture fundamentals, assembly language programming, and how high-level programming constructs map to machine instructions."
  },
  "purpose": {
    "why": "This course builds essential understanding of computer systems from the ground up. You'll develop skills in low-level programming, understand how software interacts with hardware, and gain insights that improve your ability to write efficient code.",
    "beyond": "Beyond technical skills, you'll develop systematic thinking about computational problems, understand performance trade-offs, and gain appreciation for the engineering decisions that shape modern computing systems."
  },
  "slos": [
    "Describe fundamental concepts of computer architecture and organization",
    "Discuss the mapping from high-level programming languages to machine language",
    "Write and debug assembly language programs",
    "Analyze the performance implications of architectural design decisions"
  ],
  "schedule": {
    "phases": [
      {
        "title": "Phase 1: Digital Logic Fundamentals (Weeks 1-4)",
        "description": "Build foundation in digital logic, Boolean algebra, and combinational circuits",
        "weeks": [
          {
            "weekNumber": 1,
            "dates": "8/17/2026 - 8/23/2026",
            "topics": [
              "Course overview and expectations",
              "Introduction to computer organization",
              "Number systems and representations",
              "Binary arithmetic and overflow"
            ],
            "assignments": [
              "Assignment 1: Number Systems Exercises (20 pts)",
              "Quiz 1: Course Introduction (10 pts)",
              "Discussion 1: Computer Evolution (5 pts)"
            ],
            "deliverableDueDate": "Week 1 Sunday 11:59 PM"
          },
          {
            "weekNumber": 2,
            "dates": "8/24/2026 - 8/30/2026",
            "topics": [
